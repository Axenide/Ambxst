{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Axenide/Ambxst/main/docs/mods/manifest.schema.json",
  "title": "Ambxst mod manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "version", "operations"],
  "properties": {
    "deprecated": { "type": "boolean", "default": false },
    "deprecated_reason": { "type": "string" },
    "depricated": { "type": "boolean", "description": "Alias for deprecated." },
    "depricated_reason": { "type": "string", "description": "Alias for deprecated_reason." },
    "changelog": {
      "type": "string",
      "description": "Package-relative path to a UTF-8 changelog, up to 64 KiB. Displayed as plain text in the update preview."
    },
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "author": { "type": "string" },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["translated", "single", "none"] },
        "defaultLanguage": { "type": "string", "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$" },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$" }
        },
        "resources": {
          "type": "object",
          "description": "Optional language-to-JSON-file mapping, relative to the package root. Files contain string keys and string values.",
          "additionalProperties": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["translated", "single"] } } },
          "then": { "required": ["defaultLanguage"] }
        },
        {
          "if": { "properties": { "mode": { "const": "translated" } } },
          "then": { "required": ["languages"] }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "const": 1 },
        "ambxst": { "type": "string" },
        "testedBaseCommits": {
          "type": "array",
          "items": { "type": "string", "minLength": 7 },
          "uniqueItems": true
        }
      }
    },
    "authorUrl": {
      "type": "string",
      "description": "Link to the author's page, shown before install and enable."
    },
    "homepage": {
      "type": "string",
      "description": "Link to the mod's own page, shown before install and enable."
    },
    "dependencies": { "$ref": "#/$defs/modIds" },
    "dependencySources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "conflicts": { "$ref": "#/$defs/modIds" },
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "$ref": "#/$defs/relativePath" }
      }
    },
    "settingsMenu": {
      "type": "object",
      "description": "Optional hint for a Settings sidebar section. The manager also detects entries in legacy patches and assigns a different section ID when enabled mods collide.",
      "additionalProperties": false,
      "required": ["section", "index"],
      "properties": {
        "section": {
          "type": "integer",
          "minimum": 0,
          "description": "Section ID used by added lines in the package patch. Core sections use 0 through 10."
        },
        "index": {
          "type": "integer",
          "description": "Default zero-based sidebar position. Negative values count from the end; -2 means penultimate."
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/overlay" },
          { "$ref": "#/$defs/patch" }
        ]
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "modIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "target"],
      "properties": {
        "type": { "const": "overlay" },
        "source": { "$ref": "#/$defs/relativePath" },
        "target": { "$ref": "#/$defs/relativePath" },
        "replace": { "type": "boolean" },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "replace": { "const": true } },
            "required": ["replace"]
          },
          "then": { "required": ["expectedSha256"] }
        }
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "const": "patch" },
        "source": { "$ref": "#/$defs/relativePath" }
      }
    }
  }
}
